  X-Robots-Tag: all

# Same shape: Pages 308s /sync-chain.html to /sync-chain, so both need naming.
/sync-chain.html
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Robots-Tag: all

/sync-chain
