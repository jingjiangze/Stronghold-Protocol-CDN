# Pages headers for the CDN documentation site.
# The site's own css/js are renamed to carry their content hash at deploy time (this zone's
# /js/* Cache Rule ignores the query string, so ?v= cannot bust it), hence the long TTL is safe.
# The HTML gets a short TTL so a copy change lands without a purge.

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# The snapshot is regenerated on every deploy; keep it short so a redeploy is visible at once.
/data/*
  Cache-Control: public, max-age=300

/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Written documents are meant to be found and read: allow indexing, and serve them as plain text
# so a browser renders them inline. (Not text/markdown: the catch-all below adds `nosniff`, and
# nosniff plus a type the browser has no viewer for turns into a download instead of a render.)
/docs/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  Content-Type: text/plain; charset=utf-8
  X-Robots-Tag: all

# Pages serves this at /bandwidth (it 308s /bandwidth.html there), so the rule must name both.
/bandwidth.html
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Robots-Tag: all

/bandwidth
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Robots-Tag: all

# Everything else is an operator surface, not content: keep it out of search.
# The catch-all deliberately carries no robots header. Pages applies every matching rule, so a
# noindex here would stack a second, contradictory X-Robots-Tag onto the documents above, and
# "all" plus "noindex" is not a signal a crawler can honour. Suppress the real paths instead.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/
  X-Robots-Tag: noindex

/index.html
  X-Robots-Tag: noindex

/css/*
  X-Robots-Tag: noindex

/js/*
  X-Robots-Tag: noindex

/data/*
  X-Robots-Tag: noindex
