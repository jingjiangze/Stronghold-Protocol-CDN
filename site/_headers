# Pages headers for the CDN documentation site.
# The site's own css/js are renamed to carry their content hash at deploy time (this zone's
# /js/* Cache Rule ignores the query string, so ?v= cannot bust it), hence the long TTL is safe.
# The HTML gets a short TTL so a copy change lands without a purge.

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# The snapshot is regenerated on every deploy; keep it short so a redeploy is visible at once.
/data/*
  Cache-Control: public, max-age=300

/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

# Written documents are meant to be found and read: allow indexing, and serve the Markdown as
# text so a browser renders it instead of downloading it.
/docs/*
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  Content-Type: text/markdown; charset=utf-8
  X-Robots-Tag: all

# Pages serves this at /bandwidth (it 308s /bandwidth.html there), so the rule must name both.
/bandwidth.html
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Robots-Tag: all

/bandwidth
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Robots-Tag: all

# Everything else on this site is an operator surface, not content: keep it out of search.
/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
