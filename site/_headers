# Pages headers for the CDN documentation site.
# Assets and fonts are content-stable and referenced with a ?v= token, so they can be cached hard;
# the HTML gets a short TTL so a copy change lands without a purge.

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# The snapshot is regenerated on every deploy; keep it short so a redeploy is visible at once.
/data/*
  Cache-Control: public, max-age=300

/*.html
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/
  Cache-Control: public, max-age=300, stale-while-revalidate=3600

/*
  X-Robots-Tag: noindex
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
