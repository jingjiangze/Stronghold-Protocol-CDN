  X-Robots-Tag: all

/mod
  Cache-Control: public, max-age=300, stale-while-revalidate=3600
  X-Robots-Tag: all

# Same shape as /bandwidth and /mod: Pages 308s the .html name to the clean URL, so both need naming.
/asset-cdn.html
